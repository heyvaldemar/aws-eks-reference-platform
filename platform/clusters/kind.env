# The kind cluster, as Argo CD sees it.
#
# bootstrap/bootstrap.sh turns this file into the Secret that registers the
# cluster with Argo CD. Labels decide which ApplicationSets generate an
# Application here; annotations are the values those Applications are
# templated with. scripts/render.py reads the same file, so what CI lints is
# what Argo CD installs.
#
# A value of @NAME@ is filled from the environment variable NAME at bootstrap.

label.environment=kind
label.enable_argo_cd=true
label.enable_cert_manager=true
label.enable_envoy_gateway=true
label.enable_external_secrets=true
label.enable_kyverno=true
label.enable_kube_prometheus_stack=true
label.enable_opentelemetry_collector=true
label.enable_velero=true
label.enable_object_store=true

annotation.platform_repo_url=@PLATFORM_REPO_URL@
annotation.platform_revision=@PLATFORM_REVISION@
annotation.cluster_name=reference-platform
annotation.domain=platform.test
annotation.cluster_issuer=platform-ca
annotation.aws_region=us-east-1
annotation.velero_bucket=velero
annotation.velero_s3_url=http://seaweedfs.object-store.svc.cluster.local:8333
