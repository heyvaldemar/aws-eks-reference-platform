# The EKS cluster, as Argo CD sees it.
#
# Same contract as kind.env. The @NAME@ values come from `terraform output`
# (see the Makefile's eks-bootstrap target): the cluster, its region, the
# Velero bucket and the Karpenter node role differ per account, and none of
# them is a credential. Pod Identity associations made in Terraform give the
# controllers their AWS permissions, so no role ARN appears below.

label.environment=eks
label.enable_argo_cd=true
label.enable_cert_manager=true
label.enable_envoy_gateway=true
label.enable_external_secrets=true
label.enable_external_dns=true
label.enable_kyverno=true
label.enable_kube_prometheus_stack=true
label.enable_opentelemetry_collector=true
label.enable_velero=true
label.enable_karpenter=true
label.enable_aws_load_balancer_controller=true

annotation.platform_repo_url=@PLATFORM_REPO_URL@
annotation.platform_revision=@PLATFORM_REVISION@
annotation.cluster_name=@CLUSTER_NAME@
annotation.domain=@DOMAIN@
annotation.cluster_issuer=@CLUSTER_ISSUER@
annotation.aws_region=@AWS_REGION@
annotation.vpc_id=@VPC_ID@
annotation.velero_bucket=@VELERO_BUCKET@
annotation.karpenter_node_role=@KARPENTER_NODE_ROLE@
annotation.karpenter_interruption_queue=@KARPENTER_INTERRUPTION_QUEUE@
